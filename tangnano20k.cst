// Tang Nano 20K (GW2AR-LV18QN88C8/I7) - SUMP logic analyzer pinout.
// Pin numbers as printed on the board's header silkscreen.

// 27 MHz crystal
IO_LOC "clk_27m" 4;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// BL616 USB-UART bridge (FPGA TX -> PC on 69, PC -> FPGA RX on 70)
IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Onboard LEDs (active low)
IO_LOC "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// Probe inputs, channel 0..15. 3.3V LVCMOS - NOT 5V tolerant!
// Weak pull-downs make unconnected channels read a steady 0; change to
// PULL_MODE=NONE if they load the signal you measure.
IO_LOC "probe[0]" 25;
IO_PORT "probe[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[1]" 26;
IO_PORT "probe[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[2]" 27;
IO_PORT "probe[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[3]" 28;
IO_PORT "probe[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[4]" 29;
IO_PORT "probe[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[5]" 30;
IO_PORT "probe[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[6]" 31;
IO_PORT "probe[6]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[7]" 41;
IO_PORT "probe[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[8]" 42;
IO_PORT "probe[8]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[9]" 48;
IO_PORT "probe[9]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[10]" 49;
IO_PORT "probe[10]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[11]" 73;
IO_PORT "probe[11]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[12]" 74;
IO_PORT "probe[12]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[13]" 75;
IO_PORT "probe[13]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[14]" 76;
IO_PORT "probe[14]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "probe[15]" 77;
IO_PORT "probe[15]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
